{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "ignorePatterns": ["src/routeTree.gen.ts"],
  "sortImports": false,
  "sortTailwindcss": true,
  "sortPackageJson": true
}
